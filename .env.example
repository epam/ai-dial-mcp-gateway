# Local development values. Copy to .env (gitignored) and fill in.
# NEVER commit a real value.
#
# Two audiences share this file: the gateway's own settings model, and the spike and
# provisioning helpers under scripts/ that talk to the local instance directly. A key
# the model does not consume is ignored there, so both can read the same file.

# ------------------------------------------------------------------ DIAL Core

# Core on the host, for the helpers that script the instance from outside the containers.
DIAL_CORE_URL=http://localhost:8081

# Core as the gateway reaches it, from inside the instance's compose network. These are
# deliberately two settings: the gateway is a container, so the host-reachable URL would
# not resolve for it.
DIAL_CORE_BASE_URL=http://core:8080

# ------------------------------------------------------------------ Identity provider
#
# The gateway's federation profile: the OIDC identity provider this deployment
# federates. The gateway is provider-neutral — these settings name a provider class,
# not a product; the local development instance's profile is documented in
# docs/local-environment.md.

# The browser-facing issuer, pinned exactly: the `iss` every identity token carries
# regardless of which port the token endpoint was reached on. The placeholder names the
# RFC 2606 reserved domain, so a deployment that never set it fails loudly at the
# identity leg rather than silently pointing at a live-looking host.
IDP_ISSUER=https://idp.example.com/

# The back channel's base URL override. When set, the gateway's server-to-server calls
# are addressed to this origin with the provider's own path kept — scheme and host
# swapped, nothing else — while the browser-facing redirect and issuer matching stay
# pinned to IDP_ISSUER. Unset (the default), the calls go to the issuer's own origin:
# a single-origin provider configures nothing here. The local deployment sets it to the
# instance's internal plain-http port in `.env` — see docs/local-environment.md.
IDP_BACKCHANNEL_BASE_URL=

# The gateway's own pre-registered identity-provider client — a confidential client
# whose secret (IDP_CLIENT_SECRET below) authenticates every identity-leg token request.
# `scripts/provision_keycloak.py` registers it, idempotently, in the local realm.
IDP_CLIENT_ID=dial-mcp-proxy

# The gateway's client secret at the identity provider. The gateway's client is a
# confidential client: REQUIRED at startup in both positions of IDP_PKCE_ENABLED, and
# presented on every identity-leg token request (the code exchange and the refresh
# grant). Delivered by exactly ONE of two spellings, both supported: this environment
# variable, or a read-only mounted file named by IDP_CLIENT_SECRET_FILE below. Both
# configured refuses startup naming both; neither configured is the missing-secret
# refusal. Never argv, never committed. The committed placeholder stays empty: a
# deployment fills the value in its own gitignored `.env`.
IDP_CLIENT_SECRET=

# The client secret delivered as a file instead: the path of a read-only-mounted file
# (the shape a K8s Secret file takes). Exactly one of IDP_CLIENT_SECRET and
# IDP_CLIENT_SECRET_FILE is configured, both supported, no preference between them. The
# file is read once at startup, and an unreadable or blank file refuses startup naming the
# path and never the content. Empty by default (the environment-variable spelling).
IDP_CLIENT_SECRET_FILE=

# The scopes the identity-provider redirect requests, and only them. They live here rather
# than in any client-supplied parameter: a scope the client does not carry — or that is not
# a client scope at the provider at all, as `openid` is not in the local realm — fails the
# whole authorization leg. Never add `offline_access`.
IDP_CLIENT_SCOPES=profile,email

# Whether the identity leg's redirect carries a PKCE challenge on top of the client's
# authentication. On by default: the challenge is what makes an intercepted identity-leg
# code unexchangable by an interceptor that read it off the callback URL, composed with
# the client secret that authenticates every token request in either position. Turn it
# off only for a provider that cannot support PKCE: the redirect then carries no
# challenge, and the token requests authenticate with IDP_CLIENT_SECRET alone — which is
# required at startup either way. The gateway's own client-facing surface keeps requiring
# PKCE from its harness clients whichever way this is set.
IDP_PKCE_ENABLED=true

# Optional direct endpoint configuration — the OIDC discovery members, set as a trio:
# ALL THREE or NONE. Where all three are set the gateway serves the redirect, the code
# exchange, the refresh grant, and the key set from them and attempts no discovery
# fetch; a partial set refuses startup naming the missing member. Each must be a
# well-formed absolute URL, and HTTPS unless it shares IDP_BACKCHANNEL_BASE_URL's
# origin. Empty by default: discovery from IDP_ISSUER is the normal endpoint source.
IDP_AUTHORIZATION_ENDPOINT=
IDP_TOKEN_ENDPOINT=
IDP_JWKS_URI=

# How long (seconds) a fetched discovery document is reused before the next identity leg
# fetches it again. Also the documented bound on how long a provider's endpoint change
# goes unnoticed. No effect where the direct endpoint trio above is configured: that
# mode fetches nothing, and keeping its endpoints current is the operator's own.
IDP_DISCOVERY_CACHE_TTL_SECONDS=300

# The local realm's Admin API as a host-run helper reaches it, with the administrative
# credential `scripts/provision_keycloak.py` authenticates with. That credential never
# enters the gateway container: the compose file names the settings the gateway reads one
# by one, so a value the model does not consume stays on the host.
KEYCLOAK_ADMIN_URL=http://localhost:8900
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# The confidential Keycloak clients the sign-in helpers use — the local instance's own
# plumbing, not the gateway's federation profile.
#
# The first is the client the sign-in helpers request the test user's DIAL token
# through. That client carries the user's client-role mapper, which is what puts
# the `admin` role into the token's `roles` claim and so reaches Core's admin rule.
KEYCLOAK_TOKEN_CLIENT_ID=change-me
KEYCLOAK_TOKEN_CLIENT_SECRET=change-me

# The second is the Keycloak client whose user token carries the full identity claim
# set — `roles` and the per-user `project` attribution — that Core's provider entry
# reads. Kept apart from the admin-authorized client above because the two mappers are
# configured per client: the admin client grants the privilege, this one supplies the
# identity.
KEYCLOAK_IDENTITY_CLIENT_ID=change-me
KEYCLOAK_IDENTITY_CLIENT_SECRET=

# ------------------------------------------------------------------ Gateway topology

# The gateway's public origin (what harnesses see). The issuer of every token the
# gateway mints, and the base URL of every discovery document it serves.
GATEWAY_PUBLIC_ORIGIN=http://localhost:8090

# The container-internal port uvicorn binds. Never published to the host.
GATEWAY_INTERNAL_PORT=8091

# The compose network joining the gateway and router to the DIAL instance. Must match
# the instance's own network name; the default is a neutral example name, and a local
# deployment whose instance project is named otherwise sets the real network name here
# in the gitignored `.env`.
DIAL_COMPOSE_NETWORK=dial-instance_default

# ------------------------------------------------------------------ Token lifetimes

# Access-token lifetime handed to harnesses. Short by design: it bounds how long a
# leaked token is usable, and the refresh grant is what makes repeated use silent.
GATEWAY_ACCESS_TOKEN_TTL_SECONDS=600

# How long an outbound call to Core or to the identity provider may take. Generous because
# Core's credential call reaches the upstream authorization server before it answers, and a
# short timeout there would surface as a failed sign-in.
GATEWAY_OUTBOUND_TIMEOUT_SECONDS=30
# Authorization-code lifetime, and the flow record's lifetime. Both are minutes: they
# bound a browser interaction, not a session.
GATEWAY_CODE_TTL_SECONDS=300
GATEWAY_FLOW_TTL_SECONDS=600

# The refresh window: the absolute bound on how long a gateway refresh token lives, and
# therefore on how long the provider session refresh token it carries stays usable. MUST NOT
# exceed IDP_SSO_SESSION_MAX_SECONDS; startup refuses to run when it does.
GATEWAY_REFRESH_TTL_SECONDS=28800

# The operator's declared bound, in seconds, on how long the identity provider keeps its
# session-bound refresh token usable — on Keycloak the realm's SSO Session Max (read it from
# the realm's Tokens tab, or with the Admin API's `GET /admin/realms/<realm>` as
# `ssoSessionMaxLifespan`); for an external customer-identity provider, the refresh-token
# window the provider gives a client of this registration shape (the confidential client
# the gateway registers as). REQUIRED,
# with no default. This is an **assertion about the provider's session policy**, not a fact
# the gateway can learn: a green startup check is arithmetic over two settings, not provider
# truth. The failure it cannot catch — a session policy shorter than declared — surfaces at
# runtime as an `idp_session_ended` refusal on the audit trail when a refresh hits it. Where
# the provider's session policy is short, set the short window here: it is the correct
# configuration, not a degraded one.
IDP_SSO_SESSION_MAX_SECONDS=86400

# Rotation keeps the refresh window non-sliding (the replacement carries the original
# absolute expiry); the grace window only lets a request that raced a rotation through.
#
# Turning rotation OFF is valid only on a provider that does NOT rotate its own refresh token
# per grant. Where the provider does rotate per grant, the carried credential is effectively
# single-use: the first refresh consumes the provider's token, the un-rotated gateway token
# keeps presenting the same stale one, and every refresh after the first fails at the provider
# (`idp_session_ended`) — the session ends at the second refresh. The gateway cannot know the
# provider's rotation policy at startup, so this is a warning, not a startup refusal.
GATEWAY_ROTATE_REFRESH_TOKENS=true
GATEWAY_ROTATION_GRACE_SECONDS=60

# The RFC 8707 `resource` parameter is required on authorization and token requests —
# there is no other signal naming which toolset a request is for. The inference flag is
# the escape hatch for a single-toolset deployment; it is off because inferring the
# resource silently can address a token to a toolset the client never named, and it
# requires TOOLSETS to be configured with EXACTLY ONE entry (there is no "the one toolset"
# otherwise, and startup refuses the contradiction naming this setting).
GATEWAY_INFER_RESOURCE_SINGLE_TOOLSET=false

# The audience marker Core's provider entry verifies.
GATEWAY_AUDIENCE_MARKER=dial-mcp-proxy

# The claim path roles are read from in the identity token. No default on purpose: a silent
# default would produce a role-less token instead of a diagnosed misconfiguration. The path
# may be nested (`resource_access.dial-cli.roles`), and a path that resolves to nothing
# refuses issuance rather than minting a token with no roles.
ROLES_SOURCE_PATH=roles

# The claim name the roles array is re-emitted under, and the name Core's provider entry
# reads it from. The other half of the same deployment fact as the source path.
ROLES_CLAIM_NAME=roles

# ------------------------------------------------------------------ Toolset restriction

# The optional operator restriction on the toolsets the gateway serves, as a JSON object
# keyed by the client-facing name. Two modes:
#
#   * Unset (or empty) — the gateway serves EVERY platform toolset whose name passes the
#     request-time name guard. Existence is decided post-authentication, at the flow's
#     listing read, the same place Core's own unauthenticated discovery tier decides
#     nothing below authentication. A toolset added to Core is sign-in-able with no
#     reconfigure and no restart.
#   * Set — only its entries are served. Each configured entry is validated at startup: a
#     name outside [a-z0-9-]+ and a reserved front-door name each refuse the container's
#     start with a message naming the entry, because the front router's locations are
#     static and neither can be repaired at request time for a pinned name.
#
# `authentication_type` is NOT a member any more. The kind a flow acts on is Core's, read
# per flow from its public settings, so a mapping entry declares none. A mapping document
# that still carries the old `authentication_type` member is refused loudly at parse, by
# name — the one breaking operator change fails at startup rather than being ignored.
# `scopes_supported` is echoed on the toolset's protected-resource document where the
# toolset is pinned here, and belongs to the upstream leg.
#
# The resource URI is derived from the name and GATEWAY_PUBLIC_ORIGIN, so it is not
# configured here — one spelling serves the router, the discovery document, and the
# authorization request's `resource` check.
TOOLSETS=

# ------------------------------------------------------------------ Apps restriction

# The optional operator restriction on the apps the gateway serves — the apps namespace's
# twin of TOOLSETS, and an independent setting: an app and a toolset may share a name
# (they are separate registries in Core), so one shared restriction could not serve both.
# Two modes, exactly as TOOLSETS:
#
#   * Unset (or empty) — the gateway serves EVERY app whose name passes the request-time
#     app guard. Existence is decided post-authentication, at the flow's app read, the same
#     place the toolset flow decides it — the mirror property, apps namespace. An app added
#     to Core is sign-in-able with no reconfigure and no restart.
#   * Set — only its entries are served. Each configured entry is validated at startup for
#     the one routing refusal that applies here: a name outside [a-z0-9-]+, which refuses
#     the container's start with a message naming the entry. Unlike a toolset name, an app
#     name has no reserved-name refusal — nothing the gateway owns is served under the apps
#     name segment (the reserved names are all `/dial/`-scoped).
#
# An entry declares NOTHING but the name: an app has no authentication kind (it is
# credential-free by construction) and no scopes to echo (no upstream leg exists for an
# app resource to send scopes on). An entry that carries any other member — `scopes_supported`,
# a kind, anything — is refused loudly at parse, by field name.
#
# Resource inference (GATEWAY_INFER_RESOURCE_SINGLE_TOOLSET) is toolset-only and never
# consults this restriction.
#
# The app resource URI is derived from the name and GATEWAY_PUBLIC_ORIGIN, exactly as a
# toolset's is: {GATEWAY_PUBLIC_ORIGIN}/apps/{name}/mcp.
APPS=

# ------------------------------------------------------------------ Client registration

# Clients an operator registered out of band, as a JSON object keyed by client id. The
# first rung of the resolution order (pre-registered → client-id metadata document →
# gated dynamic registration), and the only one whose source of truth is the operator.
#
# A client id here must be quoted as JSON and carry at least one `redirect_uris` entry;
# an authorization request naming this client is validated against exactly that list.
PRE_REGISTERED_CLIENTS=

# Origins allowed to name a client-id metadata document, comma-separated. The CIMD fetch
# refuses any other origin, and refuses http, redirects, and private/loopback/link-local
# addresses entirely.
GATEWAY_CIMD_ALLOWED_ORIGINS=https://claude.ai

# The `User-Agent` the client-metadata fetch carries. The origin is fronted by bot
# protection that rejects library-default agents outright, so this is load-bearing.
GATEWAY_CIMD_USER_AGENT=dial-mcp-gateway/0.1 (+mcp-signin)

# The fetch's bounds: connect and total timeouts in seconds, the response-size cap in
# bytes, and the cache's TTL and bound.
GATEWAY_CIMD_CONNECT_TIMEOUT_SECONDS=5
GATEWAY_CIMD_TOTAL_TIMEOUT_SECONDS=10
GATEWAY_CIMD_MAX_DOCUMENT_BYTES=65536
GATEWAY_CIMD_CACHE_TTL_SECONDS=300
GATEWAY_CIMD_CACHE_MAX_ENTRIES=256

# How many client-id metadata fetches may run at once on the shared worker pool. Every leg
# runs on that pool, and this fetch is the one slow leg whose target an unauthenticated
# caller chooses: the bound is what keeps an attacker's slow fetches from holding the whole
# pool and starving the identity and credential legs of the flow.
GATEWAY_CIMD_MAX_CONCURRENT_FETCHES=8

# ------------------------------------------------------------------ Abuse bounds

GATEWAY_FLOWS_MAX_LIVE=10000
GATEWAY_RATE_PER_SOURCE_PER_MINUTE=30
GATEWAY_RATE_GLOBAL_PER_MINUTE=600

# The segment-count cap on a resource path the guard resolves. The front door addresses
# resources by their Core resource path — one or more path segments, e.g.
# `toolsets/public/{name}` — where the one-segment name vocabulary bounded depth by
# construction, so this restores the bound. No Core depth limit exists, so the front door
# states one rather than inheriting none. It joins the byte cap (Core's own 900-byte path
# bound, applied to the decoded resource path) as the second dimension a caller could
# otherwise grow without limit; an over-depth path is refused before any work proportional
# to it.
RESOURCE_PATH_MAX_SEGMENTS=32

# The hard cap on live approved-client entries — the consent/attribution checkpoint's
# per-user registry, with oldest-first eviction. An entry is written only by a user's
# approve click on a live sign-in flow, so it cannot be flooded: reach it costs a
# completed sign-in under the flow store's own bounds. At the cap the oldest approvals are
# dropped first, and a dropped approval re-prompts the decision page once (fail-safe). The
# registry is process memory: a restart forgets every approval and re-prompts on the next
# sign-in for each client, by design. No operator bypass exists — the checkpoint is the
# one decision the surface carries.
GATEWAY_APPROVED_CLIENTS_MAX=10000

# The byte cap on a form body at the token and revocation endpoints, applied while the body
# is read. Both endpoints are unauthenticated, so a request that is merely large must cost
# the gateway a bounded amount of memory rather than whatever its sender chose. 16384, not
# 8192: a refresh request carries the gateway's own refresh token — which now carries the
# encrypted custody claim — in its form body, and the shared cap means /dial/revoke's read
# bound rises with it. COUPLED with GATEWAY_CUSTODY_PROVIDER_TOKEN_MAX_BYTES: raising the
# provider-token bound past this cap's headroom makes sign-ins succeed while every refresh
# fails over-cap. Startup refuses a combination that does not fit, naming both.
GATEWAY_FORM_MAX_BODY_BYTES=16384

# ------------------------------------------------------------------ Audit bounds

# The longest a caller-supplied fact may be in an audit record, in characters. A refusal
# records the request's own values (client id, redirect URI, resource, resource name) so an
# operator can diagnose it from the log, but the length of such a value is the caller's
# choice: an over-long one is truncated to this cap rather than written in full, so the
# record cannot be grown without limit by the traffic it exists to report.
AUDIT_FACT_MAX_LENGTH=256

# ------------------------------------------------------------------ Dynamic client registration

# The fallback registration path. Off by default: when off, the registration endpoint
# answers the disabled-error and the authorization-server metadata advertises no
# registration endpoint. A store left behind stays dormant, not deleted.
DCR_ENABLED=false
DCR_STORE_PATH=/data/dcr-registrations.json
DCR_MAX_REGISTRATIONS=1024

# The registration request's bounds. The endpoint is unauthenticated and accepts a body, so
# the body is capped while it is read: a request that is merely large must cost the gateway
# a bounded amount of memory. The per-record caps bound what a single accepted registration
# may contain, so the store's record cap (above) bounds how many records there are and these
# bound how large each one is.
#
# The body cap is the governing bound of the two: the per-record maxima have to be jointly
# reachable inside it, or they would advertise a registration the endpoint then refuses as
# oversized. Startup refuses a combination that does not fit, naming both settings, so
# raising a per-record bound means raising DCR_MAX_BODY_BYTES with it.
DCR_MAX_BODY_BYTES=8192
DCR_MAX_REDIRECT_URIS=8
DCR_MAX_REDIRECT_URI_LENGTH=512
DCR_MAX_CLIENT_NAME_LENGTH=256

# ------------------------------------------------------------------ Custody

# The dedicated AES-256 key that seals the identity provider's session-bound refresh token
# into every gateway refresh token. REQUIRED: a JSON object of key-id -> key. The flat
# spelling below carries EXACTLY ONE entry — one active env-sourced key, no retention (the
# pre-keyset compat shape). A structured spelling (key-id -> {source, ref, role}) carries
# one active entry plus any number of retained entries; a document mixing the two refuses
# startup naming the keyset. Any key that is not exactly 32 bytes is refused. Each key is a
# 32-byte value in base64:
#
#   openssl rand -base64 32
#   GATEWAY_CUSTODY_KEYS={"k-2026-11":"<paste>"}   <- quote the JSON so compose passes it whole
#
# The structured spelling, for a rotation (key-id -> {source, ref, role}):
#   GATEWAY_CUSTODY_KEYS={"k-2026-12":{"source":"env","ref":"CUSTODY_KEY_2026_12","role":"active"},
#                         "k-2026-11":{"source":"env","ref":"CUSTODY_KEY_2026_11","role":"retained"}}
#
# The key is separate from GATEWAY_SIGNING_KEY (this one decrypts, it never signs) and is
# treated as secret material: never committed, never logged.
#
# ROTATION IS AN OVERLAP. A superseded key may be retained for the drain window beside the
# active one: sealing is always under the ACTIVE key, decryption accepts the active OR a
# retained key (the envelope's key-id selecting), and each presenting session re-seals its
# replacement under the active key — so a routine rotation logs no one out. Its bound is the
# refresh token's non-sliding absolute expiry. The hard cut is the EXPLICIT act: remove the
# retained entry and every outstanding token sealed under it refuses fail-closed at its next
# presentation (the emergency path when a key compromise is suspected). The overlap needs
# the structured spelling; this flat spelling is one active entry with no retention.
GATEWAY_CUSTODY_KEYS=

# The largest provider session refresh token the gateway will carry, in bytes. A token over
# this bound fails the flow at sign-in with an operator-facing error naming the bound — the
# carrier it must fit inside is a refresh token handed to a harness token store the gateway
# does not control, so failing at sign-in (where the cause is diagnosable) is deliberate.
# COUPLED with GATEWAY_FORM_MAX_BODY_BYTES above: the two must move together.
GATEWAY_CUSTODY_PROVIDER_TOKEN_MAX_BYTES=4096

# ------------------------------------------------------------------ Secrets

# The gateway's token signing key (generate; treat as IdP-grade secret material).
# Whoever holds it can mint any identity Core will trust, so it is never committed and
# never logged. Override it in .env with a generated key; this placeholder is inert.
# This is the NO-ROTATION shape: one active env-sourced key, no retained entries. For a
# rotation (active + retained entries), use GATEWAY_SIGNING_KEYS below instead — the two
# settings are mutually exclusive, and configuring both refuses startup naming both.
GATEWAY_SIGNING_KEY=generate-me

# The structured signing keyset: a JSON object keyed by entry-id, each entry carrying
# `source` (`env` or `file`), `ref` (the environment variable's name, or the file's path),
# and `role` (`active` or `retained`). Exactly one entry is `active`; a `kms` source is
# reserved and refuses startup naming the gap. Empty by default (the singular spelling
# above is the no-rotation shape). Example:
#   GATEWAY_SIGNING_KEYS={"2026-11":{"source":"env","ref":"SIGNING_KEY_2026_11","role":"active"}}
GATEWAY_SIGNING_KEYS=

# ------------------------------------------------------------------ Test user (PoC)

# The realm user the verification helpers sign in as. Consumed by the helpers under
# `scripts/` (the credential helper, the provisioning script's `--verify-claims`, the
# end-to-end smoke), never by the gateway.
TEST_USER_NAME=dial
TEST_USER_PASSWORD=change-me

# The client `scripts/probe_end_to_end.py` walks the sign-in as. It must be one the
# gateway resolves — either a `PRE_REGISTERED_CLIENTS` entry, or a client-id metadata
# document URL under `GATEWAY_CIMD_ALLOWED_ORIGINS` — and its `redirect_uris` must include
# `http://127.0.0.1:8767/callback`, the probe's own listener.
GATEWAY_E2E_CLIENT_ID=